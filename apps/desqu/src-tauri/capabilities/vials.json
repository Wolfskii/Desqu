{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "vial-windows",
  "description": "Capability for the vial windows on the desktop (drag by the title bar, open items)",
  "windows": [
    "vial-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "vials-module:default"
  ]
}
